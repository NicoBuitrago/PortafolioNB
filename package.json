    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "express": "^4.21.2",
    "cors": "^2.8.6",
    "express-validator": "^7.3.2",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
